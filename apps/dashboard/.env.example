# Dashboard runs on Vite port 5174 (see package.json / vite.config.ts).
# Point this at the API's actual port. The API reads PORT from apps/api/.env
# (currently 3009); the root .env fallback is 3000. Match whichever your API prints
# on boot: "AI Checkout API listening on http://localhost:<port>".
VITE_API_BASE_URL=http://localhost:3009

# Where the theme live-preview loads the checkout widget bundle (widget.css +
# aacp.js). The API serves the built bundle at /widget/*, so point this at
# <API_BASE>/widget. Leave unset to use the code default (${API_BASE}/widget).
VITE_WIDGET_BUNDLE_URL=http://localhost:3009/widget

# Optional: default merchant id used by demo/overview pages.
# VITE_MERCHANT_ID=mrc_demo

# ─── Meta Embedded Signup (WhatsApp Commerce) ───────────────────────────────
# Used by WhatsApp Seller page to load FB SDK and open Embedded Signup popup.
VITE_META_APP_ID=1350309300356518
VITE_EMBEDDED_SIGNUP_CONFIG_ID=2347331535755786
