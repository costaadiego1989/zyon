{
  "name": "@zyon/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:store-builder": "playwright test e2e/store-builder --grep @store-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@zyon/shared-types": "workspace:*",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^5.0.0",
    "socket.io-client": "4.8.1",
    "typescript": "^5.7.2",
    "uplot": "^1.6.32",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vitest": "^3.0.9"
  }
}
