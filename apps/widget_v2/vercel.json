{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "ignoreCommand": "node ../../scripts/vercel-deploy-guard.mjs",
  "buildCommand": "pnpm --filter @zyon/widget-v2 build:app",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(self), camera=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:; frame-ancestors 'self' https://app.zyon-payments.com.br https://storefront.zyon-payments.com.br;" }
    ]
  }]
}
