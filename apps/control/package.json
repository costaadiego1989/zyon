{
  "name": "@zyon/control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests *.config.ts --max-warnings 0",
    "e2e:prospecting": "playwright test -c playwright.prospecting.config.ts"
  },
  "dependencies": {
    "@zyon/shared-types": "workspace:*",
    "@zyon/platform-support-ui": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "4.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.4",
    "jsdom": "29.1.1",
    "typescript-eslint": "8.59.2",
    "vitest": "3.2.4"
  }
}
