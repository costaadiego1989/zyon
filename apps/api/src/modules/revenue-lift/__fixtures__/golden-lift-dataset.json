      }
    },
    {
      "name": "ai_costs_zero_roi_null",
      "description": "AI costs = 0 → roi = null (NOT Infinity); gross/net still computed.",
      "holdout": { "sessions": 100, "orders": 10, "totalRevenueCents": 100000 },
