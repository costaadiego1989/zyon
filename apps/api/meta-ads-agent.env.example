# Meta Ads Agent server configuration
# Keep closed until the real cost pilot (>=40 results + evidence SHA256),
# merchant OAuth, provider permissions and operational acceptance are verified.
META_ADS_AGENT_ENABLED=false
META_ADS_AGENT_COMMERCIAL_READY=false
META_ADS_AGENT_COST_BENCHMARK_RESULTS=0
META_ADS_AGENT_COST_BENCHMARK_SHA256=
# New offers only; existing subscriptions retain their accepted offer version.
META_ADS_AGENT_MONTHLY_PRICE_CENTS=14900
META_ADS_AGENT_MONTHLY_IMAGE_CREDITS=30
META_ADS_AGENT_EXTRA_IMAGE_CREDITS=10
META_ADS_AGENT_EXTRA_IMAGE_PRICE_CENTS=3900
META_ADS_AGENT_MAX_MANAGED_CAMPAIGNS=5
# Media spend is paid directly to Meta. Approval is required for EVERY change.
META_ADS_AGENT_REMOTE_WRITES_ENABLED=false
META_ADS_AGENT_CONVERSIONS_ENABLED=false
META_ADS_AGENT_GENERATION_WORKER_ENABLED=false
META_ADS_AGENT_OBSERVATION_ENABLED=false
META_ADS_AGENT_PURCHASE_BRIDGE_ENABLED=false
# Server-only, separate from social login and WhatsApp credentials.
META_ADS_OAUTH_APP_ID=
META_ADS_OAUTH_APP_SECRET=
META_ADS_OAUTH_CONFIG_ID=
# Exact registered callback. The module handles tab=meta-ads-agent on return.
META_ADS_OAUTH_REDIRECT_URI=https://dashboard.example.com/?tab=meta-ads-agent
META_ADS_GRAPH_API_VERSION=v27.0
# Two DIFFERENT canonical base64 keys, each decoding to exactly 32 random bytes.
META_ADS_CREDENTIAL_ENCRYPTION_KEY=
META_ADS_ATTRIBUTION_SIGNING_KEY=
META_ADS_IMAGE_API_KEY=
# Exact HTTPS hosts serving canonical catalog images; no wildcards/private IPs.
META_ADS_IMAGE_SOURCE_HOSTS=
META_ADS_IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
META_ADS_CREATIVE_REVIEW_MODEL=gpt-6.1-sol
META_ADS_ANALYSIS_API_KEY=
META_ADS_ANALYSIS_MODEL=gpt-6.1-sol
# Trusted HTTPS dashboard base, without query or fragment (also Stripe return URL).
META_ADS_DASHBOARD_URL=https://dashboard.example.com/
# Dedicated addon price: BRL monthly, matching the configured current offer.
# Signed raw-body webhook: /webhooks/stripe/meta-ads-agent
META_ADS_STRIPE_SECRET_KEY=
META_ADS_STRIPE_WEBHOOK_SECRET=
META_ADS_STRIPE_MONTHLY_PRICE_ID=
