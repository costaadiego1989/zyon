// ─── WhatsApp Commerce Channel ─────────────────────────────────────────────

model WhatsAppChannelConfig {
  id         String  @id @default(uuid())
  merchantId String  @unique @map("merchant_id")
  enabled    Boolean @default(false)
  provider   String  @default("BUBBLEWHATS") @map("provider") // TWILIO | BUBBLEWHATS | META_CLOUD

  // Provider credentials (encrypted JSON)
  credentials Json @default("{}") @map("credentials")

  // WhatsApp number (E.164 format, used for webhook routing)
  whatsappNumber String? @map("whatsapp_number")

  // Connection status
  status String @default("DISCONNECTED") @map("status") // DISCONNECTED | PENDING_VERIFICATION | ACTIVE | INACTIVE

  // Legacy BubbleWhats fields (kept for backward compat)
  deviceId      String? @map("device_id")
  phoneNumber   String? @map("phone_number")
  webhookSecret String? @map("webhook_secret")

  connectedAt DateTime? @map("connected_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([whatsappNumber])
  @@index([deviceId])
  @@map("whatsapp_channel_configs")
}

model WhatsAppSession {
