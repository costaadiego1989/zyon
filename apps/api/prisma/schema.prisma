  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([merchantId, isActive, endsAt])
  @@index([merchantId, productId, isActive])
  @@index([variantId, isActive])
  @@index([categoryId, isActive])
  @@map("product_promotions")
}

// ─── Stories (Merchant-managed story categories and story content) ─────────────

model StoryCategory {
