// ─── Product Promotions (scheduled discounts per variant or category) ─────────

model ProductPromotion {
  id                String   @id @default(cuid())
  merchantId        String   @map("merchant_id")
  productId         String?  @map("product_id")
  variantId         String?  @map("variant_id")
  categoryId        String?  @map("category_id")
  couponId          String?  @map("coupon_id")
  discountType      String?  @map("discount_type") // "percent" | "fixed"; null when couponId set
  discountValue     Int?     @map("discount_value") // percent (0-100) or cents; null when couponId set
  promoPriceInCents Int?     @map("promo_price_in_cents")
  isActive          Boolean  @default(true) @map("is_active")
  startsAt          DateTime @map("starts_at")
  endsAt            DateTime @map("ends_at")
