// ─── Semantic Search (pgvector) ──────────────────────────────────────────────
// NOTE: The `embedding` column is stored as String (base64) in dev mode.
// In production with pgvector extension installed, a raw migration converts it:
//   ALTER TABLE product_search_vectors ADD COLUMN embedding_vec vector(1536);
//   CREATE INDEX idx_psv_embedding ON product_search_vectors USING hnsw (embedding_vec vector_cosine_ops);

model ProductSearchVector {
  id         String   @id @default(cuid())
  productId  String   @unique @map("product_id")
  merchantId String   @map("merchant_id")
  embedding  String?  @db.Text
  content    String
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([merchantId])
  @@map("product_search_vectors")
}

enum MerchantRole {
  OWNER
  ADMIN
  STAFF
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model MerchantTeamMember {
