  items         Json
  subtotal      Float
  total         Float
  note          String?
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([merchantId, status])
  @@map("budget_requests")
}

// ─── A/B Testing: Prompt Experiments (ab-testing-prompts spec) ────────────────

model PromptExperiment {
  id              String    @id @default(cuid())
  merchantId      String    @map("merchant_id")
  name            String
  description     String?
  status          String    @default("draft") // draft, running, completed, archived
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  winnerVariantId String?   @map("winner_variant_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  variants PromptVariant[]

  @@unique([merchantId, name])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@map("prompt_experiments")
}

model PromptVariant {
  id           String   @id @default(cuid())
  experimentId String   @map("experiment_id")
  name         String
  weight       Int      @default(1)
  isControl    Boolean  @default(false) @map("is_control")
  systemPrompt String   @map("system_prompt") @db.Text
  appliedRuleId String? @map("applied_rule_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  experiment PromptExperiment      @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  results    PromptVariantResult[]

  @@unique([experimentId, name])
  @@index([experimentId])
  @@map("prompt_variants")
}

model PromptVariantResult {
  id              String   @id @default(cuid())
  variantId       String   @map("variant_id")
  sessionId       String   @map("session_id")
  converted       Boolean
  revenue         Decimal? @db.Decimal(12, 4)
  offersShown     Int      @default(0) @map("offers_shown")
  offersAccepted  Int      @default(0) @map("offers_accepted")
  durationSeconds Int?     @map("duration_seconds")

  // Funnel stages
  conversationStarted Boolean @default(true) @map("conversation_started")
  cartViewed          Boolean @default(false) @map("cart_viewed")
  cartItemsAdded      Int     @default(0) @map("cart_items_added")
  checkoutStarted     Boolean @default(false) @map("checkout_started")
  checkoutCompleted   Boolean @default(false) @map("checkout_completed")

  // Stage timing (seconds from session start)
  timeToCart       Int? @map("time_to_cart")
  timeToCheckout   Int? @map("time_to_checkout")
  timeToConversion Int? @map("time_to_conversion")

  createdAt DateTime @default(now()) @map("created_at")

  variant PromptVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, sessionId])
  @@index([variantId, createdAt])
  @@index([variantId, checkoutCompleted, createdAt], name: "idx_prompt_variant_results_funnel")
  @@map("prompt_variant_results")
}

model MarketplaceConfig {
  id                   String   @id @default(cuid())
  merchantId           String   @unique @map("merchant_id")
  enabled              Boolean  @default(false)
  commissionRateBps    Int      @default(1500) @map("commission_rate_bps")
  returnWindowDays     Int      @default(7) @map("return_window_days")
  payoutDelayDays      Int      @default(14) @map("payout_delay_days")
  chargebackWindowDays Int      @default(30) @map("chargeback_window_days")
  allowedCategories    String[] @map("allowed_categories")
  blockedMerchants     String[] @map("blocked_merchants")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("marketplace_configs")
}

model MarketplaceConnection {
  id               String   @id @default(cuid())
  buyerMerchantId  String   @map("buyer_merchant_id")
  sellerMerchantId String   @map("seller_merchant_id")
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([buyerMerchantId, sellerMerchantId])
  @@index([buyerMerchantId, status])
  @@map("marketplace_connections")
}

model FederatedProduct {
