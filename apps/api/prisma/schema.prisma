generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MerchantPlan {
  CHECKOUT_ONLY
  STORE_ONLY
  BOTH
}

model Merchant {
  id                     String         @id
  name                   String
  theme                  Json?
  stripeConnectAccountId String?        @map("stripe_connect_account_id")
  cryptoPaymentsEnabled  Boolean        @default(false) @map("crypto_payments_enabled")
  plan                   MerchantPlan   @default(CHECKOUT_ONLY)
  eventVersion           Int            @default(0) @map("event_version")
  shardId                Int?           @map("shard_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  users                  MerchantUser[]
  apiKeys                MerchantApiKey[]
  webhookEndpoints       MerchantWebhookEndpoint[]
  webhookDeliveries      MerchantWebhookDelivery[]
  shipments              Shipment[]
  commerceConnection     MerchantCommerceConnection?
  commercePendingOrders  CommercePendingOrder[]
  commercePaidEvents     CommercePaidEvent[]
  httpIdempotencyRecords HttpIdempotencyRecord[]
  paymentConnections     MerchantPaymentConnection[]
  billingSubscription    MerchantBillingSubscription?
  onboardingState        MerchantOnboardingState?
  installations          MerchantInstallation[]
  auditEvents            MerchantAuditEvent[]

  @@map("merchants")
}

model MerchantOnboardingState {
  merchantId String   @id @map("merchant_id")
  steps      Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_onboarding_states")
}

model MerchantInstallation {
  id             String    @id @default(cuid())
  merchantId     String    @map("merchant_id")
  name           String
  environment    String
  status         String    @default("active")
  widgetVersion  String    @map("widget_version")
  allowedOrigins String[]  @map("allowed_origins")
  lastHealthAt   DateTime? @map("last_health_at")
  lastSeenAt     DateTime? @map("last_seen_at")
  lastErrorCode  String?   @map("last_error_code")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, name, environment])
  @@index([merchantId, environment, status])
  @@map("merchant_installations")
}

model MerchantAuditEvent {
  id            String   @id @default(cuid())
  merchantId    String   @map("merchant_id")
  actorType     String   @map("actor_type")
  actorId       String   @map("actor_id")
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  correlationId String?  @map("correlation_id")
  metadata      Json     @default("{}")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, occurredAt, id])
  @@index([merchantId, resourceType, resourceId])
  @@map("merchant_audit_events")
}

model MerchantCommerceConnection {
  merchantId       String    @id @map("merchant_id")
  provider         String    @default("shopify")
  shopDomain       String    @map("shop_domain")
  adminTokenCipher String    @map("admin_token_cipher")
  apiVersion       String?   @map("api_version")
  status           String    @default("pending")
  lastTestedAt     DateTime? @map("last_tested_at")
  lastSyncedAt     DateTime? @map("last_synced_at")
  lastErrorCode    String?   @map("last_error_code")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([provider, status])
  @@map("merchant_commerce_connections")
}

model MerchantPaymentConnection {
  merchantId        String    @map("merchant_id")
  provider          String
  environment       String
  status            String    @default("pending")
  externalAccountId String?   @map("external_account_id")
  secretCipher      String?   @map("secret_cipher")
  walletId          String?   @map("wallet_id")
  chargesEnabled    Boolean   @default(false) @map("charges_enabled")
  payoutsEnabled    Boolean   @default(false) @map("payouts_enabled")
  requirements      Json?
  lastSyncedAt      DateTime? @map("last_synced_at")
  lastErrorCode     String?   @map("last_error_code")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, provider])
  @@index([provider, status])
  @@map("merchant_payment_connections")
}

model MerchantBillingSubscription {
  merchantId           String    @id @map("merchant_id")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  status               String    @default("trialing")
  trialEndsAt          DateTime? @map("trial_ends_at")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([status, trialEndsAt])
  @@map("merchant_billing_subscriptions")
}

model CommercePendingOrder {
  merchantId       String   @map("merchant_id")
  sessionId        String   @map("session_id")
  commerceOrderId  String   @map("commerce_order_id")
  status           String   @default("pending")
  paymentReference String?  @map("payment_reference")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, sessionId])
  @@index([merchantId, status, updatedAt])
  @@map("commerce_pending_orders")
}

model CommercePaidEvent {
  merchantId       String   @map("merchant_id")
  paymentReference String   @map("payment_reference")
  commerceOrderId  String   @map("commerce_order_id")
  createdAt        DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, paymentReference])
  @@index([merchantId, createdAt])
  @@map("commerce_paid_events")
}

model MerchantUser {
  id           String   @id @default(cuid())
  merchantId   String   @map("merchant_id")
  email        String
  passwordHash String   @map("password_hash")
  role         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  agentRules AgentRule[]

  @@unique([email])
  @@index([merchantId])
  @@map("merchant_users")
}

model AgentRule {
  id               String   @id @default(cuid())
  agentId          String   @map("agent_id")
  merchantId       String   @map("merchant_id")
  userId           String?  @map("user_id")
  scope            String
  identity         Json
  capabilities     Json
  guardrails       Json
  checkoutSettings Json     @map("checkout_settings")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user MerchantUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, agentId])
  @@unique([merchantId, userId, scope])
  @@index([merchantId, userId])
  @@map("agent_rules")
}

model CheckoutSetting {
  id                 String   @id @default(cuid())
  merchantId         String   @unique @map("merchant_id")
  mode               String
  widgetBehavior     Json     @map("widget_behavior")
  interventionPolicy Json     @map("intervention_policy")
  triggerRules       Json     @map("trigger_rules")
  suppressionRules   Json     @map("suppression_rules")
  handoff            Json
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([merchantId])
  @@map("checkout_settings")
}

model CheckoutSession {
  id               String   @id @default(cuid())
  merchantId       String   @map("merchant_id")
  sessionId        String   @map("session_id")
  globalUserId     String   @map("global_user_id")
  conversationId   String   @map("conversation_id")
  cart             Json
  customer         Json?
  shipping         Json?
  shippingOptions  Json?    @map("shipping_options")
  abandonmentScore Float    @default(0) @map("abandonment_score")
  triggerAgent     Boolean  @default(false) @map("trigger_agent")
  chatHistory      Json     @default("[]") @map("chat_history")
  version          Int      @default(0)
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @map("updated_at")

  events           CheckoutEvent[]
  authorizedOffers AuthorizedOffer[]
  acceptedOffers   AcceptedOffer[]
  completedOrders  CompletedOrder[]

  @@unique([merchantId, sessionId])
  @@index([merchantId, updatedAt])
  @@index([merchantId, createdAt])
  @@index([globalUserId, merchantId, createdAt])
  @@map("checkout_sessions")
}

model CheckoutEvent {
  id         String   @id @default(cuid())
  merchantId String   @map("merchant_id")
  sessionId  String   @map("session_id")
  eventName  String   @map("event_name")
  occurredAt DateTime @map("occurred_at")

  session CheckoutSession @relation(fields: [merchantId, sessionId], references: [merchantId, sessionId], onDelete: Cascade)

  @@index([merchantId, sessionId, occurredAt])
  @@map("checkout_events")
}

model BuyerIdentity {
  id           String @id @default(cuid())
  merchantId   String @map("merchant_id")
  identityKey  String @map("identity_key")
  globalUserId String @map("global_user_id")

  @@unique([merchantId, identityKey])
  @@index([merchantId, globalUserId])
  @@map("buyer_identities")
}

model MerchantRule {
  id                                String   @id @default(cuid())
  merchantId                        String   @unique @map("merchant_id")
  maxDiscountPercent                Decimal  @map("max_discount_percent") @db.Decimal(12, 4)
  minimumMarginPercent              Decimal  @map("minimum_margin_percent") @db.Decimal(12, 4)
  allowFreeShipping                 Boolean  @map("allow_free_shipping")
  allowShippingDiscount             Boolean  @map("allow_shipping_discount")
  allowBonusItem                    Boolean  @map("allow_bonus_item")
  allowStackDiscountAndFreeShipping Boolean  @map("allow_stack_discount_and_free_shipping")
  couponBoxEnabled                  Boolean  @map("coupon_box_enabled")
  freeShippingMinCartValue          Decimal  @map("free_shipping_min_cart_value") @db.Decimal(12, 4)
  maxShippingSubsidy                Decimal  @map("max_shipping_subsidy") @db.Decimal(12, 4)
  maxPartialShippingDiscount        Decimal  @map("max_partial_shipping_discount") @db.Decimal(12, 4)
  offerExpirationMinutes            Int      @map("offer_expiration_minutes")
  blockedRegions                    String[] @map("blocked_regions")
  brandVoice                        String   @map("brand_voice")
  originZip                         String?  @map("origin_zip")
  quickReplies                      Json?    @map("quick_replies")
  cryptoPayments                    Json?    @map("crypto_payments")
  updatedAt                         DateTime @updatedAt @map("updated_at")

  @@map("merchant_rules")
}

model SupportSetting {
  id         String   @id @default(cuid())
  merchantId String   @unique @map("merchant_id")
  faqItems   Json     @map("faq_items")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([merchantId])
  @@map("support_settings")
}

model SupportTicket {
  id           String    @id
  merchantId   String    @map("merchant_id")
  sessionId    String?   @map("session_id")
  buyerMessage String    @map("buyer_message")
  status       String
  source       String
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  resolvedAt   DateTime? @map("resolved_at")

  @@index([merchantId, status, createdAt])
  @@index([merchantId, sessionId])
  @@map("support_tickets")
}

model AuthorizedOffer {
  id               String   @id
  merchantId       String   @map("merchant_id")
  sessionId        String   @map("session_id")
  type             String
  value            Decimal  @db.Decimal(12, 4)
  approved         Boolean
  reason           String
  marginAfterOffer Decimal  @map("margin_after_offer") @db.Decimal(12, 4)
  expiresAt        DateTime @map("expires_at")
  discountCode     String?  @map("discount_code")

  session        CheckoutSession @relation(fields: [merchantId, sessionId], references: [merchantId, sessionId], onDelete: Cascade)
  acceptedOffers AcceptedOffer[]

  @@index([merchantId, sessionId])
  @@map("authorized_offers")
}

model AcceptedOffer {
  id               String   @id @default(cuid())
  merchantId       String   @map("merchant_id")
  sessionId        String   @map("session_id")
  offerId          String   @map("offer_id")
  type             String
  value            Decimal  @db.Decimal(12, 4)
  marginAfterOffer Decimal  @map("margin_after_offer") @db.Decimal(12, 4)
  acceptedAt       DateTime @map("accepted_at")
  expiresAt        DateTime @map("expires_at")

  session CheckoutSession @relation(fields: [merchantId, sessionId], references: [merchantId, sessionId], onDelete: Cascade)
  offer   AuthorizedOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([merchantId, sessionId, offerId])
  @@index([merchantId, acceptedAt])
  @@map("accepted_offers")
}

model CompletedOrder {
  id                 String    @id @default(cuid())
  merchantId         String    @map("merchant_id")
  sessionId          String    @map("session_id")
  externalOrderId    String    @map("external_order_id")
  orderTotal         Decimal   @map("order_total") @db.Decimal(12, 4)
  currency           String
  status             String    @default("approved")
  acceptedOfferId    String?   @map("accepted_offer_id")
  trackingCode       String?   @map("tracking_code")
  completedAt        DateTime  @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")

  session CheckoutSession @relation(fields: [merchantId, sessionId], references: [merchantId, sessionId], onDelete: Cascade)

  @@unique([merchantId, sessionId, externalOrderId])
  @@index([merchantId, completedAt])
  @@index([merchantId, status, completedAt])
  @@map("completed_orders")
}

model MerchantApiKey {
  id            String    @id
  merchantId    String    @map("merchant_id")
  name          String
  keyHash       String    @unique @map("key_hash")
  keyPrefix     String    @map("key_prefix")
  scopes        String[]  @default([])
  environment   String    @default("test")
  allowedCidrs  String[]  @default([]) @map("allowed_cidrs")
  expiresAt     DateTime? @map("expires_at")
  rotatedFromId String?   @map("rotated_from_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastUsedAt    DateTime? @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, environment, revokedAt])
  @@index([merchantId, expiresAt])
  @@map("merchant_api_keys")
}

model HttpIdempotencyRecord {
  id                 String   @id @default(cuid())
  merchantId         String   @map("merchant_id")
  idempotencyKey     String   @map("idempotency_key")
  requestFingerprint String   @map("request_fingerprint")
  method             String
  route              String
  state              String   @default("processing")
  statusCode         Int?     @map("status_code")
  responseBody       Json?    @map("response_body")
  responseHeaders    Json?    @map("response_headers")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  expiresAt          DateTime @map("expires_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, state, updatedAt])
  @@index([expiresAt])
  @@map("http_idempotency_records")
}

model MerchantWebhookEndpoint {
  id            String   @id
  merchantId    String   @map("merchant_id")
  url           String
  enabled       Boolean  @default(true)
  events        String[] @default([])
  signingSecret String   @map("signing_secret")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  merchant   Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries MerchantWebhookDelivery[]

  @@index([merchantId, enabled])
  @@map("merchant_webhook_endpoints")
}

model MerchantWebhookDelivery {
  id             String    @id
  merchantId     String    @map("merchant_id")
  endpointId     String    @map("endpoint_id")
  endpointUrl    String    @map("endpoint_url")
  eventId        String    @map("event_id")
  eventType      String    @map("event_type")
  status         String
  attempts       Int       @default(0)
  envelope       Json
  signingSecret  String    @map("signing_secret")
  nextAttemptAt  DateTime? @map("next_attempt_at")
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body")
  error          String?
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  merchant Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  endpoint MerchantWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([merchantId, status, nextAttemptAt])
  @@index([merchantId, createdAt])
  @@map("merchant_webhook_deliveries")
}

model Shipment {
  id              String    @id
  merchantId      String    @map("merchant_id")
  sessionId       String    @map("session_id")
  externalOrderId String    @map("external_order_id")
  carrier         String
  trackingCode    String    @map("tracking_code")
  trackingUrl     String?   @map("tracking_url")
  status          String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  estimatedEta    DateTime? @map("estimated_eta")
  deliveredAt     DateTime? @map("delivered_at")

  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  trackingEvents TrackingEvent[]

  @@unique([merchantId, externalOrderId])
  @@unique([merchantId, trackingCode])
  @@index([merchantId, status, updatedAt])
  @@map("shipments")
}

model TrackingEvent {
  id           String   @id
  merchantId   String   @map("merchant_id")
  shipmentId   String   @map("shipment_id")
  trackingCode String   @map("tracking_code")
  status       String
  description  String
  location     String?
  carrierRaw   Json     @default("{}") @map("carrier_raw")
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([merchantId, trackingCode, occurredAt])
  @@index([shipmentId, occurredAt])
  @@map("tracking_events")
}

model BuyerPurchaseRecord {
  id                 String   @id @default(cuid())
  merchantId         String   @map("merchant_id")
  orderId            String   @map("order_id")
  globalUserId       String?  @map("global_user_id")
  merchantCustomerId String?  @map("merchant_customer_id")
  currency           String
  totalAmount        Decimal  @map("total_amount") @db.Decimal(12, 4)
  discountAmount     Decimal  @map("discount_amount") @db.Decimal(12, 4)
  completedAt        DateTime @map("completed_at")
  items              Json
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([merchantId, orderId])
  @@index([merchantId, globalUserId])
  @@index([merchantId, merchantCustomerId])
  @@index([merchantId, completedAt])
  @@map("buyer_purchase_records")
}

model MerchantNegotiationPolicy {
  merchantId String   @id @map("merchant_id")
  policy     Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("merchant_negotiation_policies")
}

model BuyerAgentNegotiationPreference {
  id           String   @id @default(cuid())
  merchantId   String   @map("merchant_id")
  globalUserId String   @map("global_user_id")
  preferences  Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([merchantId, globalUserId])
  @@index([merchantId])
  @@map("buyer_agent_negotiation_preferences")
}

model NegotiationSession {
  id                   String   @id @default(cuid())
  merchantId           String   @map("merchant_id")
  globalUserId         String?  @map("global_user_id")
  cartFingerprint      String   @map("cart_fingerprint")
  resultJson           Json     @map("result_json")
  estimatedAiCalls     Int      @map("estimated_ai_calls")
  estimatedAiCostCents Int      @map("estimated_ai_cost_cents")
  createdAt            DateTime @default(now()) @map("created_at")

  ledgerEntries NegotiationCostLedgerEntry[]

  @@index([merchantId, createdAt])
  @@map("negotiation_sessions")
}

model NegotiationCostLedgerEntry {
  id                   String   @id @default(cuid())
  merchantId           String   @map("merchant_id")
  negotiationSessionId String   @map("negotiation_session_id")
  eventType            String   @map("event_type")
  amountCents          Int      @map("amount_cents") // C3 fix: deprecated — use aiCostCents or discountBasisPoints
  aiCostCents          Int?     @map("ai_cost_cents") // For negotiation.evaluated entries
  discountBasisPoints  Int?     @map("discount_basis_points") // For negotiation.offer_applied entries
  createdAt            DateTime @default(now()) @map("created_at")

  session NegotiationSession @relation(fields: [negotiationSessionId], references: [id], onDelete: Cascade)

  @@unique([negotiationSessionId, eventType]) // H2 fix: concurrent-apply protection
  @@index([merchantId, negotiationSessionId])
  @@map("negotiation_cost_ledger_entries")
}

model OutboxMessage {
  eventId       String    @id @map("event_id")
  eventType     String    @map("event_type")
  schemaVersion Int       @map("schema_version")
  merchantId    String    @map("merchant_id")
  occurredAt    DateTime  @map("occurred_at")
  correlationId String    @map("correlation_id")
  causationId   String    @map("causation_id")
  producer      String
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime? @map("next_attempt_at")
  deliveredAt   DateTime? @map("delivered_at")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}

model OutboxHandlerExecution {
  eventId     String   @map("event_id")
  handlerId   String   @map("handler_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, handlerId])
  @@index([eventId])
  @@map("outbox_handler_executions")
}

model CheckoutIntervention {
  id         String   @id @default(cuid())
  merchantId String   @map("merchant_id")
  sessionId  String   @map("session_id")
  occurredAt DateTime @map("occurred_at")
  reason     String

  @@index([merchantId, sessionId, occurredAt])
  @@map("checkout_interventions")
}

model ShippingQuote {
  id                 String   @id
  merchantId         String   @map("merchant_id")
  sessionId          String   @map("session_id")
  destinationZip     String   @map("destination_zip")
  quoteKey           String   @map("quote_key")
  results            Json
  selectedCarrierKey String?  @map("selected_carrier_key")
  createdAt          DateTime @default(now()) @map("created_at")
  expiresAt          DateTime @map("expires_at")

  @@index([merchantId, sessionId, createdAt])
  @@index([merchantId, quoteKey, expiresAt])
  @@map("shipping_quotes")
}

model PaymentIntent {
  id                  String   @id
  merchantId          String   @map("merchant_id")
  sessionId           String   @map("session_id")
  idempotencyKey      String   @map("idempotency_key")
  amountCents         Int      @map("amount_cents")
  currency            String
  method              String
  status              String
  providerPaymentId   String?  @map("provider_payment_id")
  approvedAmountCents Int?     @map("approved_amount_cents")
  acceptedOfferId     String?  @map("accepted_offer_id")
  commerceOrderId     String?  @map("commerce_order_id")
  buyerFacing         Json?    @map("buyer_facing")
  statusHistory       Json     @default("[]") @map("status_history")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([merchantId, sessionId, idempotencyKey])
  @@unique([merchantId, providerPaymentId])
  @@index([merchantId, sessionId])
  @@index([merchantId, commerceOrderId])
  @@index([status, updatedAt])
  @@map("payment_intents")
}

model PaymentProviderEvent {
  id          String   @id
  provider    String   @default("asaas")
  merchantId  String?  @map("merchant_id")
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([provider, merchantId, eventId])
  @@index([merchantId, processedAt])
  @@map("payment_provider_events")
}

model PaymentCryptoTransfer {
  id         String   @id
  chain      String
  txHash     String   @map("tx_hash")
  merchantId String   @map("merchant_id")
  intentId   String   @map("intent_id")
  observedAt DateTime @default(now()) @map("observed_at")
  expiresAt  DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '5 minutes'")) @map("expires_at") // H1 fix: reaper pattern

  @@unique([chain, txHash])
  @@index([merchantId, intentId])
  @@index([expiresAt])
  @@map("payment_crypto_transfers")
}

model BuyerAccount {
  globalUserId String   @id @default(cuid()) @map("global_user_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  phone        String?
  cpf          String?
  address      Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agentProfile       BuyerAgentProfile?
  addresses          BuyerAddress[]
  conversations      BuyerConversation[]
  buyerPreferences   BuyerPreference[]
  webauthnCredentials WebAuthnCredential[]

  @@map("buyer_accounts")
}

/// Saved delivery addresses for a buyer (buyer-hub REQ-BH-004). One default
/// address per buyer (is_default=true). Hard cap of 5 enforced at the
/// use-case layer.
model BuyerAddress {
  id            String   @id @default(cuid())
  globalUserId  String   @map("global_user_id")
  zip           String
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  account BuyerAccount @relation(fields: [globalUserId], references: [globalUserId], onDelete: Cascade)

  @@index([globalUserId])
  @@map("buyer_addresses")
}

/// Past conversation a buyer had with the agent in a merchant checkout
/// session (buyer-hub REQ-BH-007). Messages stored as JSONB; rating is
/// up/down/null per agent message.
model BuyerConversation {
  id            String   @id @default(cuid())
  globalUserId  String   @map("global_user_id")
  sessionId     String   @map("session_id")
  merchantId    String   @map("merchant_id")
  messages      Json
  startedAt     DateTime @default(now()) @map("started_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  account BuyerAccount @relation(fields: [globalUserId], references: [globalUserId], onDelete: Cascade)

  @@index([globalUserId, lastMessageAt])
  @@index([merchantId, sessionId])
  @@map("buyer_conversations")
}

/// Buyer communication preferences, agent negotiation preferences and
/// notification toggles (buyer-hub REQ-BH-006). One row per buyer (global).
model BuyerPreference {
  id                       String   @id @default(cuid())
  globalUserId             String   @unique @map("global_user_id")
  emailOptIn               Boolean  @default(true) @map("email_opt_in")
  smsOptIn                 Boolean  @default(false) @map("sms_opt_in")
  whatsappOptIn            Boolean  @default(false) @map("whatsapp_opt_in")
  m2mNegotiationEnabled    Boolean  @default(false) @map("m2m_negotiation_enabled")
  language                 String   @default("pt-BR")
  pushNotificationsEnabled Boolean  @default(true) @map("push_notifications_enabled")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  account BuyerAccount @relation(fields: [globalUserId], references: [globalUserId], onDelete: Cascade)

  @@map("buyer_preferences")
}

model BuyerAgentProfile {
  id                               String    @id @default(cuid())
  globalUserId                     String    @unique @map("global_user_id")
  name                             String
  personality                      String
  maxRounds                        Int       @map("max_rounds")
  targetDiscountPercent            Decimal   @map("target_discount_percent") @db.Decimal(12, 4)
  minimumAcceptableDiscountPercent Decimal   @map("minimum_acceptable_discount_percent") @db.Decimal(12, 4)
  autoAcceptThreshold              Decimal?  @map("auto_accept_threshold") @db.Decimal(12, 4)
  m2mEnabled                       Boolean   @default(false) @map("m2m_enabled")
  m2mTokenHash                     String?   @map("m2m_token_hash")
  m2mTokenCreatedAt                DateTime? @map("m2m_token_created_at")
  createdAt                        DateTime  @default(now()) @map("created_at")
  updatedAt                        DateTime  @updatedAt @map("updated_at")

  account BuyerAccount @relation(fields: [globalUserId], references: [globalUserId], onDelete: Cascade)

  @@map("buyer_agent_profiles")
}

// --- Foundations: shared persistence for buyer OTP and login abuse counters ---

/// Persistent buyer phone OTP store. Replaces the in-process Map so codes are
/// verifiable across instances and survive restarts. The code is stored hashed
/// (never in clear). `attempts` + `expiresAt` back throttling/lockout so a
/// 6-digit code is not brute-forceable (buyer-account ADR B2/B3).
model BuyerPhoneOtp {
  id          String    @id @default(cuid())
  phone       String    @unique
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumedAt  DateTime? @map("consumed_at")
  lastSentAt  DateTime  @default(now()) @map("last_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")

  @@index([expiresAt])
  @@map("buyer_phone_otps")
}

/// WebAuthn (FIDO2) credential store. Each row is a registered authenticator
/// bound to a buyer account and origin. The public key material is stored as
/// a raw ECDSA P-256 uncompressed point (65 bytes). Per spec REQ-WA-005 the
/// column should be encrypted at rest via Prisma field-level encryption or
/// column-level database encryption.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  credentialId String    @unique @map("credential_id")
  globalUserId String    @map("global_user_id")
  publicKey    Bytes     @map("public_key")
  counter      Int       @default(0)
  transports   String[]  @default([])
  aaguid       String    @default("00000000-0000-0000-0000-000000000000")
  origin       String
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  account BuyerAccount @relation(fields: [globalUserId], references: [globalUserId], onDelete: Cascade)

  @@index([globalUserId])
  @@map("webauthn_credentials")
}

/// Persistent, shared login-abuse counter. Replaces the per-instance Map so the
/// rate limit is global across horizontally-scaled instances (auth ADR B2,
/// buyer-account ADR B3). Keyed by a trusted identifier (resolved client IP
/// and/or normalized email), never by a client-controlled header.
model LoginAttemptCounter {
  id          String   @id @default(cuid())
  scopeKey    String   @unique @map("scope_key")
  count       Int      @default(0)
  windowEndsAt DateTime @map("window_ends_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([windowEndsAt])
  @@map("login_attempt_counters")
}

// --- Growth context: coupons (coupons ADR) ---

model Coupon {
  id             String    @id
  merchantId     String    @map("merchant_id")
  code           String
  discountType   String    @map("discount_type")
  discountValue  Decimal   @map("discount_value") @db.Decimal(12, 4)
  minCartTotal   Decimal?  @map("min_cart_total") @db.Decimal(12, 4)
  maxUsages      Int?      @map("max_usages")
  maxPerBuyer    Int?      @map("max_per_buyer")
  usagesCount    Int       @default(0) @map("usages_count")
  allowedSkus    String[]  @default([]) @map("allowed_skus")
  blockedSkus    String[]  @default([]) @map("blocked_skus")
  allowedRegions String[]  @default([]) @map("allowed_regions")
  blockedRegions String[]  @default([]) @map("blocked_regions")
  status         String    @default("active")
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  redemptions CouponRedemption[]

  @@unique([merchantId, code])
  @@index([merchantId, status])
  @@map("coupons")
}

model CouponRedemption {
  id                 String    @id
  couponId           String    @map("coupon_id")
  merchantId         String    @map("merchant_id")
  sessionId          String    @map("session_id")
  buyerGlobalUserId  String?   @map("buyer_global_user_id")
  discountApplied    Decimal   @map("discount_applied") @db.Decimal(12, 4)
  source             String
  status             String    @default("applied")
  orderId            String?   @map("order_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  // One live application per (session, coupon): enforces apply idempotency and
  // makes the global usage reservation race-free (coupons ADR P1 TOCTOU).
  @@unique([merchantId, sessionId, couponId])
  @@index([merchantId, couponId, status])
  @@index([merchantId, buyerGlobalUserId, couponId, status])
  @@map("coupon_redemptions")
}

// --- Growth context: cross-sell (cross-sell ADR) ---

model CrossSellPromotion {
  id                 String    @id
  merchantId         String    @map("merchant_id")
  name               String
  trigger            Json
  recommendedSkus    String[]  @default([]) @map("recommended_skus")
  discountPercent    Decimal   @map("discount_percent") @db.Decimal(12, 4)
  maxDiscountPercent Decimal   @map("max_discount_percent") @db.Decimal(12, 4)
  status             String    @default("active")
  startsAt           DateTime  @map("starts_at")
  endsAt             DateTime? @map("ends_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  suggestions CrossSellSuggestion[]

  @@index([merchantId, status])
  @@map("cross_sell_promotions")
}

model CrossSellSuggestion {
  id               String    @id
  merchantId       String    @map("merchant_id")
  sessionId        String    @map("session_id")
  promoId          String    @map("promo_id")
  rankedItems      String[]  @default([]) @map("ranked_items")
  agentCopy        String    @map("agent_copy")
  computedDiscount Decimal   @map("computed_discount") @db.Decimal(12, 4)
  status           String    @default("pending")
  suggestedAt      DateTime  @map("suggested_at")
  resolvedAt       DateTime? @map("resolved_at")

  promotion CrossSellPromotion @relation(fields: [promoId], references: [id], onDelete: Cascade)

  // Dedup pending suggestions per (session, promo) (cross-sell ADR P2).
  @@index([merchantId, sessionId, promoId, status])
  @@index([merchantId, status])
  @@map("cross_sell_suggestions")
}

// --- Growth context: scraping-agent price-quote jobs (scraping-agent ADR) ---

model PriceQuoteJob {
  id                String    @id
  merchantId        String    @map("merchant_id")
  sessionId         String    @map("session_id")
  buyerGlobalUserId String?   @map("buyer_global_user_id")
  rawQuery          String    @map("raw_query")
  normalizedQuery   Json?     @map("normalized_query")
  requestedSources  String[]  @default([]) @map("requested_sources")
  status            String    @default("pending")
  results           Json      @default("[]")
  rankedResults     String[]  @default([]) @map("ranked_results")
  routingDecision   String?   @map("routing_decision")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([merchantId, status, createdAt])
  @@index([merchantId, sessionId])
  @@map("price_quote_jobs")
}

// --- Growth context: self-checkout buyer wallet & templates (self-checkout ADR) ---

model SelfCheckoutBuyerUser {
  id               String   @id
  merchantId       String   @map("merchant_id")
  email            String   @map("email")
  passwordHash     String   @map("password_hash")
  displayName      String?  @map("display_name")
  consentVersion   String   @map("consent_version")
  consentUpdatedAt DateTime @map("consent_updated_at")
  marketingOptIn   Boolean  @default(false) @map("marketing_opt_in")
  createdAt        DateTime @default(now()) @map("created_at")

  wallet    SelfCheckoutWallet?
  templates SelfCheckoutTemplate[]

  // Email is normalized to lowercase before write/lookup (self-checkout ADR P2).
  @@unique([merchantId, email])
  @@map("self_checkout_buyer_users")
}

model SelfCheckoutWallet {
  id          String   @id
  buyerUserId String   @unique @map("buyer_user_id")
  // Optimistic-lock version: a stale save (read version != stored) is rejected
  // instead of overwriting concurrent wallet mutations (self-checkout ADR P2).
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  buyerUser      SelfCheckoutBuyerUser         @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  addresses      SelfCheckoutSavedAddress[]
  paymentMethods SelfCheckoutSavedPaymentMethod[]

  @@map("self_checkout_wallets")
}

model SelfCheckoutSavedAddress {
  id        String  @id
  walletId  String  @map("wallet_id")
  label     String
  zipCode   String  @map("zip_code")
  street    String
  city      String
  state     String
  country   String
  isDefault Boolean @default(false) @map("is_default")

  wallet SelfCheckoutWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("self_checkout_saved_addresses")
}

model SelfCheckoutSavedPaymentMethod {
  id           String   @id
  walletId     String   @map("wallet_id")
  label        String
  gateway      String
  gatewayToken String   @map("gateway_token")
  lastFour     String   @map("last_four")
  brand        String
  expiresAt    DateTime @map("expires_at")
  isDefault    Boolean  @default(false) @map("is_default")

  wallet SelfCheckoutWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("self_checkout_saved_payment_methods")
}

model SelfCheckoutTemplate {
  id                       String   @id
  buyerUserId              String   @map("buyer_user_id")
  merchantId               String   @map("merchant_id")
  name                     String
  savedAddressId           String   @map("saved_address_id")
  savedPaymentMethodId     String   @map("saved_payment_method_id")
  preferredShippingMethodId String? @map("preferred_shipping_method_id")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")

  buyerUser SelfCheckoutBuyerUser @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)

  @@index([buyerUserId])
  @@index([merchantId, buyerUserId])
  @@map("self_checkout_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE BUILDER: Catalog Module (ADR-0030)
// ─────────────────────────────────────────────────────────────────────────────

enum MediaType {
  IMAGE
  VIDEO
}

enum StockReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

model ProductCategory {
  id         String    @id @default(cuid())
  merchantId String    @map("merchant_id")
  name       String
  slug       String
  parentId   String?   @map("parent_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([merchantId, slug])
  @@index([merchantId])
  @@map("product_categories")
}

model Product {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  name        String
  description String?
  categoryId  String?  @map("category_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category    ProductCategory?    @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  reviews     ProductReview[]
  collections CollectionProduct[]

  @@index([merchantId])
  @@index([merchantId, isActive, createdAt])
  @@index([merchantId, categoryId, isActive])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  sku            String
  attributes     Json     @default("{}")
  barcode        String?
  weightGrams    Int?     @map("weight_grams")
  lengthCm       Float?   @map("length_cm")
  widthCm        Float?   @map("width_cm")
  heightCm       Float?   @map("height_cm")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  media        ProductMedia[]
  price        ProductPrice?
  stock        ProductStock[]
  reservations StockReservation[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String    @id @default(cuid())
  variantId String    @map("variant_id")
  url       String
  type      MediaType @default(IMAGE)
  alt       String?
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("product_media")
}

model ProductPrice {
  id              String   @id @default(cuid())
  variantId       String   @unique @map("variant_id")
  basePriceInCents Int     @map("base_price_in_cents")
  costInCents     Int?     @map("cost_in_cents")
  taxPercent      Float    @default(0) @map("tax_percent")
  currency        String   @default("BRL")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

model ProductStock {
  id          String   @id @default(cuid())
  variantId   String   @map("variant_id")
  warehouseId String?  @map("warehouse_id")
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@map("product_stock")
}

model StockReservation {
  id        String                 @id @default(cuid())
  variantId String                 @map("variant_id")
  cartId    String?                @map("cart_id")
  quantity  Int
  status    StockReservationStatus @default(ACTIVE)
  expiresAt DateTime               @map("expires_at")
  createdAt DateTime               @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, status])
  @@index([expiresAt, status])
  @@map("stock_reservations")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  buyerId   String   @map("buyer_id")
  rating    Int
  title     String?
  body      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, approved])
  @@index([buyerId])
  @@map("product_reviews")
}

model ProductCollection {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products CollectionProduct[]

  @@index([merchantId])
  @@map("product_collections")
}

model CollectionProduct {
  id           String @id @default(cuid())
  collectionId String @map("collection_id")
  productId    String @map("product_id")
  order        Int    @default(0)

  collection ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("collection_products")
}

// ─── Returns / RMA ────────────────────────────────────────────────────────────

enum ReturnStatus {
  REQUESTED
  LABEL_GENERATED
  SHIPPED
  RECEIVED
  INSPECTED_PASS
  INSPECTED_FAIL
  REFUND_PROCESSING
  REFUND_COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  DAMAGED_IN_TRANSIT
  OTHER
}

enum ItemCondition {
  NEW
  GOOD
  DAMAGED
  UNUSABLE
}

model Return {
  id         String       @id @default(cuid())
  merchantId String       @map("merchant_id")
  orderId    String       @map("order_id")
  buyerId    String       @map("buyer_id")
  reason     ReturnReason
  notes      String?
  status     ReturnStatus @default(REQUESTED)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  items      ReturnItem[]
  label      ReturnLabel?
  inspection ReturnInspection?
  refund     ReturnRefund?

  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([orderId])
  @@map("returns")
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String  @map("return_id")
  variantId String  @map("variant_id")
  quantity  Int
  reason    String?

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_items")
}

model ReturnLabel {
  id             String   @id @default(cuid())
  returnId       String   @unique @map("return_id")
  carrier        String
  trackingNumber String   @map("tracking_number")
  labelUrl       String?  @map("label_url")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_labels")
}

model ReturnInspection {
  id            String        @id @default(cuid())
  returnId      String        @unique @map("return_id")
  inspectedBy   String        @map("inspected_by")
  itemCondition ItemCondition @map("item_condition")
  verdict       String
  notes         String?
  inspectedAt   DateTime      @default(now()) @map("inspected_at")

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_inspections")
}

model ReturnRefund {
  id              String    @id @default(cuid())
  returnId        String    @unique @map("return_id")
  paymentIntentId String?   @map("payment_intent_id")
  amountInCents   Int       @map("amount_in_cents")
  status          String    @default("PENDING")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_refunds")
}

// ─── Store Analytics ──────────────────────────────────────────────────────────

model StoreMetricDaily {
  id                 String   @id @default(cuid())
  merchantId         String   @map("merchant_id")
  date               DateTime @db.Date
  conversations      Int      @default(0)
  orders             Int      @default(0)
  revenueInCents     Int      @default(0) @map("revenue_in_cents")
  avgOrderValue      Int      @default(0) @map("avg_order_value")
  conversionRate     Float    @default(0) @map("conversion_rate")
  avgSessionDuration Int      @default(0) @map("avg_session_duration_secs")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([merchantId, date])
  @@index([merchantId, date])
  @@map("store_metrics_daily")
}

model StoreProductMetric {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  productId   String   @map("product_id")
  month       DateTime @db.Date
  impressions Int      @default(0)
  addToCart   Int      @default(0) @map("add_to_cart")
  purchases   Int      @default(0)
  revenue     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([merchantId, productId, month])
  @@index([merchantId, month])
  @@map("store_product_metrics")
}

// ─── Semantic Search (pgvector) ──────────────────────────────────────────────
// NOTE: The `embedding` column uses Unsupported("vector(1536)") because Prisma
// does not natively support pgvector types. Actual vector queries use raw SQL
// via prisma.$queryRaw. A raw migration adds the vector column + HNSW index:
//   ALTER TABLE product_search_vectors ADD COLUMN embedding vector(1536);
//   CREATE INDEX idx_psv_embedding ON product_search_vectors USING hnsw (embedding vector_cosine_ops);

model ProductSearchVector {
  id         String                       @id @default(cuid())
  productId  String                       @unique @map("product_id")
  merchantId String                       @map("merchant_id")
  embedding  Unsupported("vector(1536)")?
  content    String
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  @@index([merchantId])
  @@map("product_search_vectors")
}

