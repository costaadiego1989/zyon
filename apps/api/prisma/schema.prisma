  expiresAt    DateTime @map("expires_at")
  isDefault    Boolean  @default(false) @map("is_default")

  wallet SelfCheckoutWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("self_checkout_saved_payment_methods")
}

model SelfCheckoutTemplate {
  id                        String   @id
  buyerUserId               String   @map("buyer_user_id")
  merchantId                String   @map("merchant_id")
  name                      String
  savedAddressId            String   @map("saved_address_id")
  savedPaymentMethodId      String   @map("saved_payment_method_id")
  preferredShippingMethodId String?  @map("preferred_shipping_method_id")
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at")

  buyerUser SelfCheckoutBuyerUser @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)

  @@index([buyerUserId])
  @@index([merchantId, buyerUserId])
  @@map("self_checkout_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE BUILDER: Catalog Module (ADR-0030)
// ─────────────────────────────────────────────────────────────────────────────

enum MediaType {
  IMAGE
  VIDEO
}

enum StockReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

model ProductCategory {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  name        String
  slug        String
  parentId    String?  @map("parent_id")
  description String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([merchantId, slug])
  @@index([merchantId])
  @@map("product_categories")
}

model Product {
  id              String    @id @default(cuid())
  merchantId      String    @map("merchant_id")
  name            String
  description     String?
  type            String    @default("physical")
  metadata        Json?
  categoryId      String?   @map("category_id")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at")
  seoTitle        String?   @map("seo_title")
  metaDescription String?   @map("meta_description")
  slug            String?   @unique
  ogTitle         String?   @map("og_title")
  ogDescription   String?   @map("og_description")
  twitterCard     String?   @map("twitter_card")
  keywords        String[]  @default([])
  seoGeneratedAt  DateTime? @map("seo_generated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category    ProductCategory?    @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  reviews     ProductReview[]
  collections CollectionProduct[]

  @@index([merchantId])
  @@index([merchantId, isActive, createdAt])
  @@index([merchantId, categoryId, isActive])
  @@index([slug])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  sku         String
  attributes  Json     @default("{}")
  barcode     String?
  weightGrams Int?     @map("weight_grams")
  lengthCm    Float?   @map("length_cm")
  widthCm     Float?   @map("width_cm")
  heightCm    Float?   @map("height_cm")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  media        ProductMedia[]
  price        ProductPrice?
  stock        ProductStock[]
  reservations StockReservation[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String    @id @default(cuid())
  variantId String    @map("variant_id")
  url       String
