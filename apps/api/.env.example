# =============================================================================
# AACP API - Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Group legend:
#   REQUIRED IN PRODUCTION  - startup fails fast in NODE_ENV=production if missing
#                             (enforced by assertRequiredSecretsInProduction).
#   REQUIRED (DEVELOPMENT)  - the API expects a value; outside production a
#                             deterministic dev fallback is used, but real values
#                             are strongly recommended for accurate behaviour.
#   OPTIONAL                - feature toggles, integrations, or test gates. The
#                             API starts without them; functionality is reduced.
#
# In production, missing REQUIRED keys abort boot with
# `missing_required_secrets:<list>` so the deployment fails once with the full
# list instead of crashing later at first use.
# =============================================================================


# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------

# Runtime profile. Values: production | development | test.
# Production enables strict secret validation and disables dev fallbacks.
NODE_ENV=development

# HTTP port the NestJS API binds to. Default: 3001.
PORT=3001

# Custom domains — CNAME target merchants point their domains to.
STOREFRONT_CNAME_TARGET=stores.zyon.com


# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (PRODUCTION_REQUIRED_SECRETS)
# -----------------------------------------------------------------------------
# These four keys are asserted at startup. In production, missing/blank values
# cause the process to exit with `missing_required_secrets:<names>`.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/aacp?schema=public

# Redis connection for delayed jobs (billing trial expiration, workers).
REDIS_URL=redis://localhost:6379

# HMAC secret used to sign merchant JWTs (auth context). Use >=32 random bytes.
JWT_SECRET=replace-with-32-byte-random-secret

# HMAC secret used to sign buyer JWTs (self-checkout / buyer-account contexts).
# Must differ from JWT_SECRET.
BUYER_JWT_SECRET=replace-with-32-byte-random-secret

# HMAC secret used to sign storefront embed session tokens. >=16 characters.
EMBED_TOKEN_SECRET=replace-with-min-16-char-secret


# -----------------------------------------------------------------------------
# JWT - general
# -----------------------------------------------------------------------------

# Token lifetime in seconds for merchant JWTs. Default if unset: 86400 (24h).
JWT_EXPIRES_IN_SECONDS=86400


# -----------------------------------------------------------------------------
# LLM provider - conversation engine
# -----------------------------------------------------------------------------
# At least one provider key is required to run live AI flows. Without any key
# the conversation-engine falls back to deterministic safe templates (MVP).
# OPENAI takes precedence when both are set.

# OpenAI (chat completions API).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (OpenAI-compatible API). Cheaper, used as the default for live AI
# checkout e2e specs.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenRouter (multi-model proxy).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-merchant soft cap for AI-spend in cents. Used by the rules-engine.
AI_BUDGET_CENTS=500


# -----------------------------------------------------------------------------
# Shopify commerce adapter
# -----------------------------------------------------------------------------

# *.myshopify.com domain (without protocol).
SHOPIFY_SHOP_DOMAIN=
# Admin API access token (Custom App - Admin API access scope).
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Admin API version (e.g. 2025-04).
SHOPIFY_API_VERSION=2025-04
# Storefront API access token (used for public storefront reads).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Demo merchant id used by integration tests / fixtures.
SHOPIFY_DEMO_MERCHANT_ID=


# -----------------------------------------------------------------------------
# Asaas payment provider (BR PIX / billet / card)
# -----------------------------------------------------------------------------

# Master toggle: when "true", requests go to the sandbox base URL.
ASAAS_SANDBOX=true
# Production API key (aact_prod_...).
ASAAS_API_KEY=
# Sandbox API key (aact_YTU...).
ASAAS_API_KEY_SANDBOX=
# Production base URL. Default: https://www.asaas.com/api/v3.
ASAAS_BASE_URL=https://www.asaas.com/api/v3
# Sandbox base URL. Default: https://sandbox.asaas.com/api/v3.
ASAAS_BASE_URL_SANDBOX=https://sandbox.asaas.com/api/v3
# Webhook auth token configured in the Asaas dashboard.
ASAAS_WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
# Stripe (alt payment provider / testing)
# -----------------------------------------------------------------------------

# Live keys (server-side use only).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Test-mode keys (sk_test_/pk_test_/whsec_...).
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=


# -----------------------------------------------------------------------------
# Shipping - Melhor Envio (BR)
# -----------------------------------------------------------------------------

MELHOR_ENVIO_BASE_URL=https://melhorenvio.com.br/api/v2
MELHOR_ENVIO_TOKEN=
# Origin ZIP code used for shipping quotes.
MELHOR_ENVIO_FROM_ZIP=


# -----------------------------------------------------------------------------
# Messaging - Brevo (transactional email)
# -----------------------------------------------------------------------------

BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=AACP


# -----------------------------------------------------------------------------
# Messaging - BubbleWhats / Twilio / Meta WhatsApp
# -----------------------------------------------------------------------------

BUBBLEWHATS_API_URL=
BUBBLEWHATS_TOKEN=
TWILIO_FROM_NUMBER=

# Platform Twilio account (shared across all merchants)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Meta Embedded Signup for WhatsApp Commerce
# Used to exchange OAuth codes and subscribe to WABA webhooks.
META_APP_ID=
META_APP_SECRET=


# -----------------------------------------------------------------------------
# WebAuthn (passkey) configuration
# -----------------------------------------------------------------------------

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AACP
WEBAUTHN_ORIGIN=http://localhost:3000


# -----------------------------------------------------------------------------
# WalletConnect (crypto wallet connect)
# -----------------------------------------------------------------------------

WALLETCONNECT_PROJECT_ID=


# -----------------------------------------------------------------------------
# Crypto payments - EVM (Polygon/Base) RPCs
# -----------------------------------------------------------------------------

# Master toggle for crypto price quotes in checkout.
CRYPTO_QUOTE_ENABLED=false
# Zyon treasury wallet that receives platform fees for crypto payments.
ZYON_CRYPTO_TREASURY_ADDRESS=
# Polygon Amoy testnet RPC.
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Polygon mainnet RPC.
POLYGON_RPC_URL=
# Base Sepolia testnet RPC.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Base mainnet RPC.
BASE_RPC_URL=


# -----------------------------------------------------------------------------
# Auth - rate limiting / cookies
# -----------------------------------------------------------------------------

# Cookie name used for the merchant session JWT.
AUTH_COOKIE_NAME=aacp_session
# Max failed-login attempts per account within the rolling window.
AUTH_LOGIN_MAX_ATTEMPTS=5
# Max failed-login attempts per IP within the rolling window.
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=20
# Login attempt rolling window in ms.
AUTH_LOGIN_WINDOW_MS=900000


# -----------------------------------------------------------------------------
# Global API rate limiting (applies to every route except /health, /ready, /metrics).
# Per-route overrides via @RateLimit(limit, windowMs); bypass via @SkipRateLimit().
# -----------------------------------------------------------------------------
# Max requests per IP per window. Default: 100.
RATE_LIMIT_MAX=100
# Rolling window length in ms. Default: 900000 (15 minutes).
RATE_LIMIT_WINDOW_MS=900000


# -----------------------------------------------------------------------------
# Commerce adapter secret encryption
# -----------------------------------------------------------------------------
# AES key used to encrypt stored commerce-adapter secrets at rest. Required in
# production (asserted by commerce-secret-cipher). Use a strong random key
# (>=16 bytes; 32 bytes recommended).

AACP_COMMERCE_ENC_KEY=replace-with-32-byte-random-key


# -----------------------------------------------------------------------------
# Operations - cursor signing
# -----------------------------------------------------------------------------
# HMAC secret used by the operations read APIs (cursor tokens).

OPERATIONS_CURSOR_SECRET=replace-with-32-byte-random-secret


# -----------------------------------------------------------------------------
# Webhooks - dispatcher
# -----------------------------------------------------------------------------

# Enable background webhook dispatch worker.
WEBHOOK_DISPATCHER_ENABLED=false
# Polling interval in ms.
WEBHOOK_DISPATCH_INTERVAL_MS=2000


# -----------------------------------------------------------------------------
# Observability - OpenTelemetry
# -----------------------------------------------------------------------------

OTEL_SERVICE_NAME=aacp-api
OTEL_EXPORTER_OTLP_ENDPOINT=


# -----------------------------------------------------------------------------
# Observability - Sentry (error tracking)
# -----------------------------------------------------------------------------
# Sentry is OPTIONAL. Leave SENTRY_DSN blank to disable error tracking entirely;
# the integration then becomes a no-op and never blocks requests. The API does
# not crash if Sentry is unreachable or misconfigured.

# Sentry DSN. Format: https://<public-key>@o<org>.ingest.sentry.io/<project>
SENTRY_DSN=
# Override the release identifier. Defaults to the version in package.json.
SENTRY_RELEASE=
# Tracing sample rate (0.0 - 1.0). Default: 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling sample rate (0.0 - 1.0). Default: 0.0 (off).
SENTRY_PROFILES_SAMPLE_RATE=0.0


# -----------------------------------------------------------------------------
# Public URLs (used by docs / widget asset hosting)
# -----------------------------------------------------------------------------

# Public origin of the API (used in merchant redirects).
BASE_URL=http://localhost:3001
# Sandbox URL advertised in API docs.
AACP_SANDBOX_API_URL=
# Production URL advertised in API docs.
AACP_PRODUCTION_API_URL=
# Absolute path to the built widget bundle exposed by the widget-assets
# controller. Defaults to the packaged widget under dist/.
AACP_WIDGET_DIST_PATH=


# -----------------------------------------------------------------------------
# Platform fee (BR marketplace accounting)
# -----------------------------------------------------------------------------

PLATFORM_FEE_BRL=0.50


# -----------------------------------------------------------------------------
# Behaviour toggles
# -----------------------------------------------------------------------------

# When "true" the API mounts legacy/unversioned routes alongside v1.
ENABLE_LEGACY_ROUTES=false


# -----------------------------------------------------------------------------
# Development / E2E / test gates
# -----------------------------------------------------------------------------

# Master switch to seed deterministic dev data on boot. Never set in production
# (the API throws on startup if E2E_SEED_ENABLED=true while NODE_ENV=production).
E2E_SEED_ENABLED=false
# Default merchant id used by the dev seed script.
MERCHANT_ID=mrc_dev_seed
MERCHANT_NAME=AACP Dev Seed
# Run live AI checkout e2e specs (requires OPENAI_API_KEY or DEEPSEEK_API_KEY).
RUN_REAL_AI_E2E=false
# Run commerce (Shopify) e2e specs.
RUN_COMMERCE_E2E=false
# Run payment e2e specs.
RUN_PAYMENT_E2E=false
# Run Prisma integration specs.
AACP_RUN_PRISMA_TESTS=false
# Fake-payment provider auto-approves intents (test-only).
PAYMENT_FAKE_AUTO_APPROVE=false
# Count first-time buyer lookups for billing/metering.
METER_FIRST_TIME_LOOKUPS=false


# -----------------------------------------------------------------------------
# Repository selection / Postgres RLS (forward-compatible knobs)
# -----------------------------------------------------------------------------
# Not currently wired by the runtime (Prisma is always used in dev and prod,
# per CLAUDE.md). Listed here so ops has a documented place to set them when
# the corresponding adapter ships.

# Negotiation store backend. Allowed: prisma (default) | memory.
NEGOTIATION_REPOSITORY=prisma
# When "true", Prisma connections set the role/session vars expected by
# Postgres RLS policies. Requires the DB to be provisioned accordingly.
PRISMA_RLS=false