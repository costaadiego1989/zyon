{
  "name": "@zyon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @zyon/contracts build && pnpm --filter @zyon/shared-types build && pnpm --filter @zyon/commerce-adapters build && pnpm --filter @zyon/conversation-engine build && pnpm --filter @zyon/decision-engine build && pnpm --filter @zyon/negotiation-engine build && pnpm --filter @zyon/rules-engine build && pnpm --filter @zyon/shipping-engine build && prisma generate --schema prisma/schema.prisma && nest build",
    "start": "node dist/main.js",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "pnpm --filter @zyon/contracts --filter @zyon/shared-types --filter @zyon/commerce-adapters --filter @zyon/conversation-engine --filter @zyon/decision-engine --filter @zyon/negotiation-engine --filter @zyon/rules-engine --filter @zyon/shipping-engine build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @zyon/contracts build && pnpm --filter @zyon/shared-types build && pnpm build && node dist/test-runner.js",
    "test:prisma": "pnpm --filter @zyon/shared-types build && pnpm build && node dist/test-runner-prisma.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "ci": "pnpm typecheck && pnpm lint && pnpm test",
    "seed:dashboard": "npx tsx src/seeds/dashboard-seed.ts",
    "seed:marketplace": "npx tsx prisma/seeds/marketplace-seed.ts",
    "seed:marketplace:finance": "npx tsx prisma/seeds/marketplace-finance-seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/websockets": "^10.4.15",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/nestjs-api-reference": "1.0.31",
    "@sentry/node": "^10.66.0",
    "@sentry/profiling-node": "^10.66.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@zyon/commerce-adapters": "workspace:*",
    "@zyon/contracts": "workspace:*",
    "@zyon/conversation-engine": "workspace:*",
    "@zyon/decision-engine": "workspace:*",
    "@zyon/negotiation-engine": "workspace:*",
    "@zyon/payments-evm": "workspace:*",
    "@zyon/rules-engine": "workspace:*",
    "@zyon/shared-types": "workspace:*",
    "@zyon/shipping-engine": "workspace:*",
    "bullmq": "^5.80.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.4.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "stripe": "^22.1.1",
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-import": "^2.29.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0"
  }
}
