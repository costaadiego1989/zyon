{
  "name": "@zyon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @zyon/contracts build && pnpm --filter @zyon/shared-types build && pnpm --filter @zyon/commerce-adapters build && prisma generate --schema prisma/schema.prisma && nest build",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "pnpm --filter @zyon/contracts build && pnpm --filter @zyon/shared-types build && pnpm --filter @zyon/commerce-adapters build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @zyon/contracts build && pnpm --filter @zyon/shared-types build && pnpm build && node dist/test-runner.js",
    "test:prisma": "pnpm --filter @zyon/shared-types build && pnpm build && node dist/test-runner-prisma.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@zyon/commerce-adapters": "workspace:*",
    "@zyon/payments-stellar": "workspace:*",
    "@zyon/contracts": "workspace:*",
    "@zyon/conversation-engine": "workspace:*",
    "@zyon/decision-engine": "workspace:*",
    "@zyon/negotiation-engine": "workspace:*",
    "@zyon/rules-engine": "workspace:*",
    "@zyon/shared-types": "workspace:*",
    "@zyon/shipping-engine": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/nestjs-api-reference": "1.0.31",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ipaddr.js": "^2.4.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.1",
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0"
  }
}
