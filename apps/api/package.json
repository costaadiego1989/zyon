{
  "name": "@aacp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @aacp/shared-types build && prisma generate --schema prisma/schema.prisma && nest build",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @aacp/shared-types build && pnpm build && node dist/test-runner.js",
    "test:prisma": "pnpm --filter @aacp/shared-types build && pnpm build && node dist/test-runner-prisma.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@aacp/commerce-adapters": "workspace:*",
    "@aacp/conversation-engine": "workspace:*",
    "@aacp/decision-engine": "workspace:*",
    "@aacp/negotiation-engine": "workspace:*",
    "@aacp/rules-engine": "workspace:*",
    "@aacp/shared-types": "workspace:*",
    "@aacp/shipping-engine": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/node": "^22.10.2",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0"
  }
}
