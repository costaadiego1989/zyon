NODE_ENV=development
PORT=3000
# CORS allowlist: comma-separated origins. In production an empty/unset value
# fails safe (all cross-origin requests rejected). In dev a localhost default is
# used when unset.
CORS_ALLOWED_ORIGINS=
# Required in production (startup fails if missing). Dev/test use deterministic
# fallbacks so MVP flows work without credentials. Never commit real secrets.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
BUYER_JWT_SECRET=
# Legacy/open routes (checkout, payment, cross-sell, coupons, shipping,
# scraping, fulfillment) are disabled in production. Set to "true" only to
# explicitly re-enable them in production.
ENABLE_LEGACY_ROUTES=false
# AI provider — at least one of DEEPSEEK_API_KEY or OPENAI_API_KEY must be set
# in production for the conversation engine to call the LLM. If neither is set,
# the SendChatMessageUseCase falls back to a deterministic safe reply.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=
# Set to "true" alongside DEEPSEEK_API_KEY (or OPENAI_API_KEY) to run the live
# AI checkout e2e tests in apps/api (multi-turn purchase journey).
RUN_REAL_AI_E2E=false
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
# Postgres local (Compose): `pnpm db:up` + `pnpm db:migrate` antes de `pnpm test:prisma`.
# Docker Desktop deve estar ligado no Windows.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/aacp_test?schema=public
# Widget/API demo: leave CHECKOUT_REPOSITORY unset or in-memory for smoke tests without Postgres.
CHECKOUT_REPOSITORY=in-memory

# Background tenant webhook worker. Keep disabled locally unless you are testing webhook delivery.
WEBHOOK_DISPATCHER_ENABLED=false
# MERCHANT_REPOSITORY=prisma
# Após subir o Postgres: `pnpm test:prisma` liga AACP_RUN_PRISMA_TESTS; se a BD não responder, o comando falha já no início com instruções (ver test-runner-prisma).
# Asaas: API pública usa header access_token na cobrança. Docs: https://docs.asaas.com/docs/authentication-2
# ASAAS_SANDBOX=true → https://api-sandbox.asaas.com + ASAAS_API_KEY_SANDBOX
# ASAAS_SANDBOX=false ou vazio → https://api.asaas.com + ASAAS_API_KEY (produção)
ASAAS_SANDBOX=true
ASAAS_API_KEY_SANDBOX=
ASAAS_API_KEY=
ASAAS_API_BASE_URL=
ASAAS_API_BASE_URL_SANDBOX=
ASAAS_WEBHOOK_TOKEN=
