# ============================================================================
# AACP — Environment template
# Copy to .env and fill real values. NEVER commit .env (covered by .gitignore).
# ============================================================================

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3009
APP_VERSION=0.1.0

# ─── Database (Postgres) ───────────────────────────────────────────────────
DB_USER=atendeai
DB_PASSWORD=CHANGE_ME_LOCAL_DEV
DB_NAME=aacp_dev
DB_PORT_INTERNAL=5432
DB_PORT_HOST=5434
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT_HOST}/${DB_NAME}?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:${REDIS_PORT}

# ─── JWT / Auth ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LOCAL_DEV_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. * allowed only in dev.
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:8080,http://localhost:3009

# ─── API URL (used by frontend builds) ─────────────────────────────────────
PUBLIC_API_URL=http://localhost:3009
VITE_API_BASE_URL=http://localhost:3009

# ─── AI Providers (optional — fallbacks are deterministic) ────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Server-side only. The browser receives a short-lived Realtime client secret,
# never this project key. Set OPENAI_REALTIME_ENABLED=false to disable new voice sessions.
OPENAI_REALTIME_ENABLED=true
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Asaas ─────────────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_API_KEY_SANDBOX=
ASAAS_SANDBOX=true
ASAAS_BASE_URL=https://www.asaas.com/api/v3
ASAAS_BASE_URL_SANDBOX=https://api-sandbox.asaas.com

# ─── Melhor Envio ──────────────────────────────────────────────────────────
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ID=

# ─── Observability ─────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3100
PROMETHEUS_PORT=9091
LOKI_PORT=3101

# ─── Feature flags ─────────────────────────────────────────────────────────
E2E_SEED_ENABLED=false
WEBHOOK_DISPATCHER_ENABLED=false
CHECKOUT_REPOSITORY=in-memory

# Taxa de servico do comprador, em reais (R$ 0,99).
PLATFORM_FEE_BRL=0.99

# Annual SaaS billing. Enable only after migration and provider price verification.
BILLING_ANNUAL_ENABLED=false
BILLING_ANNUAL_DISCOUNT_PERCENT=15
STRIPE_BILLING_PRICE_GROWTH_ANNUAL=
STRIPE_BILLING_PRICE_SCALE_ANNUAL=
# Keep former annual price IDs mapped after a price change.
STRIPE_BILLING_PRICE_GROWTH_ANNUAL_LEGACY=
STRIPE_BILLING_PRICE_SCALE_ANNUAL_LEGACY=
# Billing plan catalog. `starter` is Free; `starter179` is the paid Starter.
BILLING_FREE_TRIAL_DAYS=7
BILLING_PLAN_FREE_TRANSACTION_FEE_CENTS=199
BILLING_PLAN_STARTER_MONTHLY_PRICE_BRL=179
BILLING_PLAN_STARTER_TRANSACTION_FEE_CENTS=199
BILLING_PLAN_GROWTH_MONTHLY_PRICE_BRL=449
BILLING_PLAN_GROWTH_TRANSACTION_FEE_CENTS=149
BILLING_PLAN_SCALE_MONTHLY_PRICE_BRL=749
BILLING_PLAN_SCALE_TRANSACTION_FEE_CENTS=99
# Voice guard costs are internal only. Set an explicit cap to override the estimate.
VOICE_GUARD_GROWTH_MONTHLY_BUDGET_USD=5
VOICE_GUARD_SCALE_MONTHLY_BUDGET_USD=10
VOICE_GUARD_AVERAGE_SESSION_SECONDS=300
VOICE_GUARD_INPUT_AUDIO_SHARE=0.5
VOICE_GUARD_SAFETY_MARGIN_PERCENT=20
VOICE_GUARD_AUDIO_INPUT_USD_PER_MILLION=32
VOICE_GUARD_AUDIO_OUTPUT_USD_PER_MILLION=64
STRIPE_BILLING_PRICE_STARTER_179=
STRIPE_BILLING_PRICE_STARTER_179_ANNUAL=
