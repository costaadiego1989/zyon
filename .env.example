# ============================================================================
# AACP — Environment template
# Copy to .env and fill real values. NEVER commit .env (covered by .gitignore).
# ============================================================================

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3009
APP_VERSION=0.1.0

# ─── Database (Postgres) ───────────────────────────────────────────────────
DB_USER=atendeai
DB_PASSWORD=CHANGE_ME_LOCAL_DEV
DB_NAME=aacp_dev
DB_PORT_INTERNAL=5432
DB_PORT_HOST=5434
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT_HOST}/${DB_NAME}?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:${REDIS_PORT}

# ─── JWT / Auth ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LOCAL_DEV_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. * allowed only in dev.
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:8080,http://localhost:3009

# ─── API URL (used by frontend builds) ─────────────────────────────────────
PUBLIC_API_URL=http://localhost:3009
VITE_API_BASE_URL=http://localhost:3009

# ─── AI Providers (optional — fallbacks are deterministic) ────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Asaas ─────────────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_API_KEY_SANDBOX=
ASAAS_SANDBOX=true
ASAAS_BASE_URL=https://www.asaas.com/api/v3
ASAAS_BASE_URL_SANDBOX=https://api-sandbox.asaas.com

# ─── Melhor Envio ──────────────────────────────────────────────────────────
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ID=

# ─── Observability ─────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3100
PROMETHEUS_PORT=9091
LOKI_PORT=3101

# ─── Feature flags ─────────────────────────────────────────────────────────
E2E_SEED_ENABLED=false
WEBHOOK_DISPATCHER_ENABLED=false
CHECKOUT_REPOSITORY=in-memory
