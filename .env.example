NODE_ENV=development
PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/aacp_test?schema=public
CHECKOUT_REPOSITORY=in-memory
# Asaas: API pública usa header access_token na cobrança. Docs: https://docs.asaas.com/docs/authentication-2
# ASAAS_SANDBOX=true → https://api-sandbox.asaas.com + ASAAS_API_KEY_SANDBOX
# ASAAS_SANDBOX=false ou vazio → https://api.asaas.com + ASAAS_API_KEY (produção)
ASAAS_SANDBOX=true
ASAAS_API_KEY_SANDBOX=
ASAAS_API_KEY=
ASAAS_API_BASE_URL=
ASAAS_API_BASE_URL_SANDBOX=
ASAAS_WEBHOOK_TOKEN=
