{
  "name": "@zyon/agentic-checkout-js",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @zyon/shared-types build && tsc -p tsconfig.json && tsup",
    "build:library": "pnpm --filter @zyon/shared-types build && tsc -p tsconfig.json",
    "build:umd": "tsup",
    "typecheck": "pnpm --filter @zyon/shared-types build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/embed-client.spec.js dist/checkout-embed-api.spec.js dist/umd-bundle.spec.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@zyon/shared-types": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  },
  "files": ["dist", "dist-umd"]
}
