# === Zyon Payment Splitter — Deploy Config ===

# Deployer wallet private key (needs ~0.02 MATIC for deploy gas)
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here

# Zyon treasury wallet — receives platform fees (immutable after deploy)
ZYON_TREASURY_ADDRESS=0x_your_treasury_wallet_address

# RPC endpoints
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Block explorer API keys (for contract verification)
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=

# === Post-deploy: add these to apps/api/.env ===
# PAYMENT_SPLITTER_ADDRESS=0x_deployed_contract_address
# PAYMENT_SPLITTER_CHAIN_ID=137
