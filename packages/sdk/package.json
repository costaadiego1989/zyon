{
  "name": "@zyon/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Zyon Integration API — AI-powered checkout platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "orval && node scripts/post-generate.cjs",
    "build": "tsc",
    "clean": "rm -rf dist src/generated",
    "sdk:generate": "orval && node scripts/post-generate.cjs && tsc",
    "sdk:publish": "pnpm sdk:generate && npm publish --access public",
    "sdk:publish:beta": "pnpm sdk:generate && npm publish --access public --tag beta",
    "sdk:release": "pnpm clean && pnpm sdk:generate && npm publish --access public",
    "prepublishOnly": "pnpm sdk:generate"
  },
  "keywords": [
    "aacp",
    "zyon",
    "checkout",
    "sdk",
    "api",
    "ecommerce",
    "headless"
  ],
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "orval": "^7.3.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyon-platform/aacp.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.aacp.dev/sdk",
  "bugs": "https://github.com/zyon-platform/aacp/issues"
}
