{
  "name": "zyon",
  "version": "0.1.0",
  "private": true,
  "description": "AI Checkout Sales Agent MVP monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "db:up": "node scripts/docker-engine-ok.mjs && docker compose up -d postgres",
    "db:down": "docker compose down",
    "docker:diag": "docker version && docker context ls",
    "db:migrate": "pnpm --filter @zyon/api prisma:deploy",
    "test:prisma": "pnpm --filter @zyon/api test:prisma",
    "test:e2e:db": "pnpm db:up && pnpm db:migrate && pnpm test:prisma",
    "dev:api": "pnpm --filter @zyon/api dev",
    "dev:fake-commerce": "pnpm --filter @zyon/fake-commerce-api build && pnpm --filter @zyon/fake-commerce-api start",
    "dev:widget": "pnpm --filter @zyon/widget dev",
    "dev:dashboard": "pnpm --filter @zyon/dashboard dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r build && pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  }
}
