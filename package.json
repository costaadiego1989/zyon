{
  "name": "aacp-ai-checkout-sales-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI Checkout Sales Agent MVP monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @aacp/api prisma:deploy",
    "test:prisma": "pnpm --filter @aacp/api test:prisma",
    "dev:api": "pnpm --filter @aacp/api dev",
    "dev:widget": "pnpm --filter @aacp/widget dev",
    "dev:dashboard": "pnpm --filter @aacp/dashboard dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r build && pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  }
}
